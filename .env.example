# =====================================================================
#  Windmill42 (TokenizeArt) - configuration
# ---------------------------------------------------------------------
#  1. Copy this file to `.env` at the repository root:
#         cp .env.example .env
#  2. Fill in the values below.
# =====================================================================


# Public Sepolia RPC endpoint (free, no account needed).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the wallet that deploys the contract, owns it, mints
PRIVATE_KEY=


# --- Pinata (IPFS pinning) ---------------------------------------------
# Only needed to upload the artwork once (mint/pin_to_ipfs.py).
# Pinata dashboard > API Keys > New Key (permission to upload files),
# then copy the long "JWT" value (it starts with "eyJ").
PINATA_JWT=

# Optional: Pinata dedicated gateway domain, without https://
# Leave empty to use the public gateway https://gateway.pinata.cloud
PINATA_GATEWAY=


# Address of the Windmill42 contract used by the mint TUI.
# deployment/deploy.py offers to fill it in after each deployment.
CONTRACT_ADDRESS=0x45DEDC83B233B846F6FED1a118d71bEEffAE0f97
